# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
JUDGE_PROVIDER=        # gemini or openai (a different model family from the agent)
JUDGE_API_KEY=
TAVILY_API_KEY=
RESEND_API_KEY=
OPERATOR_EMAIL=        # every email goes here while TEST_MODE=1
TEST_MODE=1
DATABASE_URL=          # Supabase Postgres connection string (new project, separate from Sprinto)
RIYA_PASSWORD=          # Riya's login (decides, edits, sends)
KUSHAL_PASSWORD=        # Kushal's login (read-only outcomes, thesis approval)
GMAIL_SENDER=           # your Gmail address that sends test emails and invites
GMAIL_APP_PASSWORD=     # a Gmail app password (Google account > Security > App passwords)
CALENDAR_ICS_URL=       # your Google Calendar's secret iCal address (read-only busy times)
# Optional: book straight onto Google Calendar (docs/mesa/google-calendar.md). Without these, invites go by email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
